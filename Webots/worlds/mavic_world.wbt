EXTERNPROTO "../protos/Puerta.proto"

WorldInfo {
  info [
    "This demonstration shows a DJI Mavic 2 PRO flying over a rural area by exposing the ROS2 Twist topic."
  ]
  title "ROS2 and DJI Mavic 2 PRO demo"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
Viewpoint {
  orientation -0.10397749630385447 -0.9734280921271486 -0.20402556143797565 5.748977969324934
  position -7.995176473996482 -1.459052737634579 6.338093076486245
  near 0.2
  follow "floor"
  followType "None"
  followSmoothness 0.2
}
TexturedBackground {
  luminosity 3
}
TexturedBackgroundLight {
}
Floor {
  size 400 400
  tileSize 6 6
  appearance SandyGround {
  }
}
SquareManhole {
  translation 0 0 -0.03
  rotation 0 0 1 -1.5707953071795862
}
Mavic2Pro {
  translation 0 0 0.1
  name "Mavic_2_PRO"
  controller "<extern>"
  cameraSlot [
    Camera {
      recognitionColors [
        0 0 0
        0 0 0
      ]
      fieldOfView 1.3212
      width 960
      height 720
      near 0.2
    }
  ]
}
Solid {
  translation 4.5 1 2.7
  rotation 0 0 1 0.7853996938995746
  children [
    DEF Puerta Puerta {
      rotation 0 1 0 -1.5708003061004252
    }
  ]
  name "Puerta"
}
