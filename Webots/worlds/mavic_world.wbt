EXTERNPROTO "../protos/Puerta.proto"

WorldInfo {
  info [
    "This demonstration shows a DJI Mavic 2 PRO flying over a rural area by exposing the ROS2 Twist topic."
  ]
  title "ROS2 and DJI Mavic 2 PRO demo"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
Viewpoint {
  orientation -0.2226216675679071 -0.20221610105569315 0.9537023862836446 5.806825724614801
  position -8.176191282389553 7.573718298331803 2.5443717563648987
  near 0.2
  follow "Mavic 2 PRO"
  followSmoothness 0.2
}
TexturedBackground {
  luminosity 3
}
TexturedBackgroundLight {
}
Floor {
  size 400 400
  tileSize 6 6
  appearance SandyGround {
  }
}
SquareManhole {
  translation 0 0 -0.03
  rotation 0 0 1 -1.5707953071795862
}
Mavic2Pro {
  translation 0 0 0.1
  name "Mavic_2_PRO"
  controller "<extern>"
  cameraSlot [
    Camera {
      recognitionColors [
        0 0 0
        0 0 0
      ]
      fieldOfView 1.3212
      width 960
      height 720
      near 0.2
    }
  ]
}
Solid {
  translation 3.5 1.5 2
  children [
    DEF Puerta Puerta {
      rotation 0 1 0 -1.5708003061004252
    }
  ]
  name "Puerta"
}
